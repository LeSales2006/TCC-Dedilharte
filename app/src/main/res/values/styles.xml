<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PasswordField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_profile_field</item>
        <item name="boxBackgroundMode">none</item>
        <item name="hintEnabled">false</item>
        <item name="endIconMode">password_toggle</item>
        <item name="endIconTint">@color/theme_ink</item>
        <item name="endIconDrawable">@drawable/ic_password_toggle</item>
    </style>
    <style name="ProfileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/theme_page_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ProfileGoalButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_dark_button_16</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="DrawerMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">#FFFFFF</item>
    </style>
</resources>
