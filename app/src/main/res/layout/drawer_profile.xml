<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B4F4C"
    android:orientation="vertical"
    android:paddingTop="23dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/drawerAvatar"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_profile_photo"
        android:contentDescription="Foto de perfil"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_branca_sem_escrita" />

    <TextView
        android:id="@+id/drawerUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drawerLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/drawerDynamicTopDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <ScrollView
        android:id="@+id/drawerDynamicScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/drawerDynamicModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:id="@+id/drawerDynamicBottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <TextView
        android:id="@+id/drawerProgress"
        style="@style/DrawerMenuItem"
        android:text="Seu progresso" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <TextView
        android:id="@+id/drawerSongs"
        style="@style/DrawerMenuItem"
        android:text="Todas as músicas" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <TextView
        android:id="@+id/drawerArpeggios"
        style="@style/DrawerMenuItem"
        android:text="Arpejos" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <TextView
        android:id="@+id/drawerSettings"
        style="@style/DrawerMenuItem"
        android:text="Configurações" />

    <View
        android:id="@+id/drawerAdminDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D2FFFFFF" />

    <TextView
        android:id="@+id/drawerAdmin"
        style="@style/DrawerMenuItem"
        android:text="Administração" />
</LinearLayout>
