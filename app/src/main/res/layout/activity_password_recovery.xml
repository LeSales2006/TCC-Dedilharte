<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recoveryRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/theme_header">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:padding="20dp"
        android:text="Recuperar senha" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:background="@color/theme_page">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="24dp" android:orientation="vertical" android:focusableInTouchMode="true">
            <TextView android:id="@+id/recoveryStep" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1 de 3 · Informe seu e-mail" android:textColor="@color/theme_page_text" android:textSize="21sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
            <LinearLayout android:id="@+id/recoveryEmailPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ProfileLabel" android:text="E-mail" android:labelFor="@id/recoveryEmail" />
                <EditText android:id="@+id/recoveryEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:padding="16dp" android:background="@drawable/bg_profile_field"
                    android:inputType="textEmailAddress" android:singleLine="true" android:hint="email@exemplo.com"
                    android:textColor="@color/theme_ink" android:textColorHint="@color/theme_hint" android:maxLength="254" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recoveryCodePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/ProfileLabel" android:text="Código de 6 dígitos" android:labelFor="@id/recoveryCode" />
                <EditText android:id="@+id/recoveryCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="64dp" android:padding="16dp" android:background="@drawable/bg_profile_field"
                    android:inputType="number" android:digits="0123456789" android:maxLength="6" android:singleLine="true"
                    android:gravity="center" android:letterSpacing="0.3" android:textSize="28sp" android:hint="000000"
                    android:contentDescription="Código de 6 dígitos" android:saveEnabled="false"
                    android:textColor="@color/theme_ink" android:textColorHint="@color/theme_hint" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recoveryPasswordPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/ProfileLabel" android:text="Nova senha" android:labelFor="@id/recoveryPassword" />
                <EditText android:id="@+id/recoveryPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:padding="16dp" android:background="@drawable/bg_profile_field" android:inputType="textPassword"
                    android:singleLine="true" android:saveEnabled="false" android:textColor="@color/theme_ink" />
                <TextView style="@style/ProfileLabel" android:layout_marginTop="16dp" android:text="Confirmar nova senha" android:labelFor="@id/recoveryConfirm" />
                <EditText android:id="@+id/recoveryConfirm" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:padding="16dp" android:background="@drawable/bg_profile_field" android:inputType="textPassword"
                    android:singleLine="true" android:saveEnabled="false" android:textColor="@color/theme_ink" />
            </LinearLayout>
            <TextView android:id="@+id/recoveryStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textSize="16sp" android:textColor="@color/theme_page_text"
                android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/recoveryProgress" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center" android:layout_marginTop="12dp" android:indeterminateTint="@color/theme_page_accent" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recoverySubmit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginTop="20dp" android:text="Enviar código" android:textAllCaps="false"
                android:textSize="17sp" android:textStyle="bold" android:textColor="#102D2B" app:backgroundTint="#54D6DD" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recoveryResend" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginTop="8dp" android:text="Reenviar código" android:textAllCaps="false"
                android:textColor="#102D2B" app:backgroundTint="#54D6DD" app:cornerRadius="16dp" android:visibility="gone" />
            <TextView android:id="@+id/recoveryBack" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="12dp" android:gravity="center" android:text="Voltar ao login"
                android:textSize="16sp" android:textColor="@color/theme_page_text" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
