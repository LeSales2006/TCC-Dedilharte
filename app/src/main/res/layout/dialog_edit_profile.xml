<?xml version="1.0" encoding="utf-8"?>
<!-- Hosted as a screen in MainActivity. The Activity owns system/IME insets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editProfileScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/theme_page" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:id="@+id/editProfilePanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">

        <LinearLayout android:id="@+id/editPhotoRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/editAvatar"
                android:layout_width="80dp" android:layout_height="80dp"
                android:background="@drawable/bg_profile_photo" android:contentDescription="Foto de perfil"
                android:padding="8dp" android:src="@drawable/ic_ms_person" android:scaleType="centerCrop" />
            <TextView android:id="@+id/editPhotoButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginStart="16dp" android:padding="16dp"
                android:background="@drawable/bg_dark_button_16" android:clickable="true" android:focusable="true"
                android:gravity="center" android:text="Alterar foto" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/ProfileLabel" android:labelFor="@id/editName" android:text="Nome" />
        <EditText android:id="@+id/editName"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginBottom="24dp" android:background="@drawable/bg_profile_field"
            android:padding="16dp" android:hint="Seu nome" android:inputType="textPersonName"
            android:singleLine="true" android:maxLength="180" android:textColor="@color/theme_header"
            android:textColorHint="@color/theme_hint" android:textSize="17sp" />

        <TextView android:id="@+id/editGoalLabel" style="@style/ProfileLabel" android:text="Meta semanal" />
        <LinearLayout android:id="@+id/editGoalRow"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/editGoalMinus" style="@style/ProfileGoalButton" />
            <TextView android:id="@+id/editGoalValue"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:padding="8dp"
                android:background="@drawable/bg_profile_field" android:gravity="center"
                android:textColor="@color/theme_header" android:textSize="16sp" android:textStyle="bold"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/editGoalPlus" style="@style/ProfileGoalButton" />
        </LinearLayout>

        <LinearLayout android:id="@+id/editPreferences" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" />

        <TextView style="@style/ProfileLabel" android:text="Segurança da conta" />
        <TextView android:id="@+id/editPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:padding="16dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_profile_field"
            android:drawableStart="@drawable/ic_ms_lock" android:drawableTint="@color/theme_header" android:drawablePadding="12dp"
            android:gravity="center_vertical" android:text="Trocar senha" android:textColor="@color/theme_header"
            android:textSize="17sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/editSave"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginBottom="12dp" android:padding="16dp" android:background="@drawable/bg_cyan_button_16"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Salvar Edições" android:textColor="@color/theme_header" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/editCancel"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:padding="16dp" android:background="@drawable/bg_profile_field"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Cancelar" android:textColor="@color/theme_header" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
