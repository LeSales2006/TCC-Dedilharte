DATABASE_URL=
JWT_SECRET=
PORT=3000
# Node.js 20+; configure these values in Render, never commit real credentials.
# Brevo API v3 key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Verified Brevo sender. Accepts "no-reply@domain.com" or "Dedilharte <no-reply@domain.com>".
MAIL_FROM=
# Stable random secret (at least 32 bytes) used to sign recovery grants; identical across instances.
PASSWORD_RECOVERY_SECRET=
# Set only after verifying the number of trusted reverse-proxy hops (typically 1 on Render).
TRUST_PROXY_HOPS=1
